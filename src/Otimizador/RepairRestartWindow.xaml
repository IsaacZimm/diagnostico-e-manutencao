<Window x:Class="ResetExplode.RepairRestartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reinicialização do Windows" Width="432" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="22" FocusManager.FocusedElement="{Binding ElementName=CancelRestart}">
        <TextBlock x:Name="CountdownText" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap"/>
        <TextBlock Text="Salve seu trabalho ou cancele para reiniciar mais tarde."
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button x:Name="CancelRestart" Content="CANCELAR REINICIALIZAÇÃO" Style="{StaticResource OutlineButton}"
                IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
