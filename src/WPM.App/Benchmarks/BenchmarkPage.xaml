<UserControl x:Class="WPM.App.Benchmarks.BenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="Page_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,14">
        <StackPanel MaxWidth="1150">
            <TextBlock Text="Benchmarks" Style="{DynamicResource PageTitle}" />
            <TextBlock Text="Compare medições feitas com o mesmo teste e as mesmas configurações."
                       Style="{DynamicResource PanelText}" Margin="0,3,0,18" />

            <Border Style="{DynamicResource Panel}">
                <StackPanel>
                    <Label Content="_Teste" Target="{Binding ElementName=Workload}" Padding="0,0,0,5" FontWeight="SemiBold" />
                    <ComboBox x:Name="Workload" DisplayMemberPath="Label" SelectionChanged="Workload_SelectionChanged"
                              AutomationProperties.Name="Tipo de benchmark" MaxWidth="450" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="Method" Style="{DynamicResource PanelText}" />

                    <StackPanel x:Name="GpuControls" Visibility="Collapsed" Margin="0,12,0,0">
                        <Label Content="_Resolução" Target="{Binding ElementName=Resolution}" Padding="0,0,0,5" FontWeight="SemiBold" />
                        <ComboBox x:Name="Resolution" AutomationProperties.Name="Resolução do teste gráfico" SelectedIndex="0"
                                  Width="150" HorizontalAlignment="Left">
                            <ComboBoxItem Content="1280 × 720" />
                            <ComboBoxItem Content="1920 × 1080" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="StorageControls" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Pasta para a amostra" FontWeight="SemiBold" />
                        <TextBlock x:Name="StoragePath" Style="{DynamicResource PanelText}" Margin="0,5,0,6" />
                        <Button x:Name="ChangeFolder" Content="Escolher pasta" Style="{DynamicResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="ChangeFolder_Click" />
                    </StackPanel>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="RunButton" Content="Executar benchmark" Style="{DynamicResource ActionButton}"
                                Click="RunButton_Click" />
                        <Button x:Name="CancelButton" Content="Cancelar teste" Style="{DynamicResource SecondaryButton}"
                                Click="CancelButton_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="BenchmarkStatus" Style="{DynamicResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Status" Style="{DynamicResource PanelTitle}" FontSize="17"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="ProgressBar" Style="{DynamicResource MetricProgress}" Margin="0,12,0,0" Maximum="100"
                                 AutomationProperties.Name="Progresso do benchmark" />
                </StackPanel>
            </Border>

            <Border x:Name="Result" Style="{DynamicResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" Style="{DynamicResource PanelTitle}" />
                    <ItemsControl x:Name="Measurements" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Image x:Name="RenderPreview" MaxWidth="640" Stretch="Uniform" Visibility="Collapsed"
                           Margin="0,14,0,0" AutomationProperties.Name="Imagem produzida pelo teste de renderização" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
