<Window x:Class="WPM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diagnostics="clr-namespace:WPM.App.Diagnostics"
        xmlns:app="clr-namespace:WPM.App"
        xmlns:games="clr-namespace:WPM.App.Games"
        xmlns:tools="clr-namespace:WPM.App.Tools"
        xmlns:monitoring="clr-namespace:WPM.App.Monitoring"
        xmlns:benchmarks="clr-namespace:WPM.App.Benchmarks"
        Title="Diagnóstico e Manutenção"
        Language="pt-BR" FontFamily="{DynamicResource InterfaceFont}" FontSize="14"
        Width="1190" Height="820" MinWidth="790" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainNavigation" TabStripPlacement="Left" SelectedIndex="0" Background="Transparent" SelectionChanged="MainNavigation_SelectionChanged"
                    BorderThickness="0" Padding="0" AutomationProperties.Name="Ferramentas do computador">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Sidebar}" Padding="13,20,13,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="4,4,4,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="37" Height="37" CornerRadius="10" Background="{StaticResource SidebarSelected}">
                                        <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   Foreground="{StaticResource SidebarAccent}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Diagnóstico e manutenção" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Surface}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SidebarScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <TabPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <StackPanel>
                                  <TextBlock x:Name="GroupTitle" Text="{Binding Path=(app:NavigationGroups.Title), RelativeSource={RelativeSource TemplatedParent}}"
                                             Foreground="{StaticResource SidebarMuted}" FontSize="11" FontWeight="SemiBold" Margin="11,13,0,4" />
                                  <Border x:Name="TabFrame" Padding="10,7" Margin="0,0,0,2" BorderThickness="1" BorderBrush="Transparent"
                                          Background="Transparent" CornerRadius="8" MinHeight="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TabIcon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="16" Foreground="{StaticResource SidebarMuted}" VerticalAlignment="Center" />
                                        <ContentPresenter Grid.Column="1" x:Name="TabLabel" ContentSource="Header" RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" TextElement.Foreground="{StaticResource SidebarText}"
                                                          TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                                    </Grid>
                                  </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="app:NavigationGroups.Title" Value="{x:Null}">
                                        <Setter TargetName="GroupTitle" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabFrame" Property="Background" Value="{StaticResource SidebarHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabFrame" Property="Background" Value="{StaticResource SidebarSelected}" />
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource SidebarAccent}" />
                                        <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{StaticResource Surface}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TabFrame" Property="BorderBrush" Value="{StaticResource SidebarAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Visão geral" Tag="&#xE80F;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,14">
                    <StackPanel MaxWidth="1150">
                        <TextBlock Text="Visão geral" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Consulte o hardware, verifique a rede e cuide da instalação do Windows."
                                   Style="{StaticResource PanelText}" Margin="0,2,0,20" />

                        <Border Style="{StaticResource Panel}" Background="{StaticResource HeroGradient}" BorderThickness="0" Padding="23,21">
                            <StackPanel>
                                <TextBlock Text="Inventário do computador" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock x:Name="OverviewSnapshotText" Text="Faça uma leitura do sistema para consultar os componentes e exportar um relatório."
                                           Foreground="{StaticResource SidebarText}" TextWrapping="Wrap" Margin="0,5,0,15" />
                                <Button x:Name="OverviewAnalyzeButton" Content="Analisar computador" HorizontalAlignment="Left"
                                        Style="{StaticResource HeroButton}" Click="OverviewAnalyzeButton_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Consultas rápidas" Style="{StaticResource PanelTitle}" Margin="0,7,0,10" />
                        <UniformGrid Columns="2" Margin="-5,0,-5,0">
                            <Button Style="{StaticResource QuickLink}" Tag="{x:Static diagnostics:DiagnosticCategory.System}"
                                    AutomationProperties.Name="Sistema e hardware" Click="OverviewCategory_Click">
                                <StackPanel>
                                    <TextBlock Text="Sistema e hardware" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Processador, placa-mãe, memória e discos" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickLink}" Tag="{x:Static diagnostics:DiagnosticCategory.Network}"
                                    AutomationProperties.Name="Rede e IPs" Click="OverviewCategory_Click">
                                <StackPanel>
                                    <TextBlock Text="Rede e IPs" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Adaptadores, endereços locais e gateway" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickLink}" AutomationProperties.Name="Sensores ao vivo" Click="OverviewSensors_Click">
                                <StackPanel>
                                    <TextBlock Text="Sensores ao vivo" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Temperaturas, cargas, clocks e consumo" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickLink}" AutomationProperties.Name="Testes de diagnóstico" Click="OverviewTests_Click">
                                <StackPanel>
                                    <TextBlock Text="Testes de diagnóstico" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Rede local, conexão de internet, processador e disco" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickLink}" AutomationProperties.Name="Arquivos temporários" Click="OverviewTemporaryFiles_Click">
                                <StackPanel>
                                    <TextBlock Text="Arquivos temporários" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Veja a prévia dos arquivos elegíveis para limpeza" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickLink}" AutomationProperties.Name="Reparo do Windows" Click="OverviewRepair_Click">
                                <StackPanel>
                                    <TextBlock Text="Reparo do Windows" Style="{StaticResource QuickLinkTitle}" />
                                    <TextBlock Text="Verifique e repare a instalação com SFC e DISM" Style="{StaticResource PanelText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DiagnosticPage" Header="Sistema" Tag="&#xE770;" app:NavigationGroups.Title="HARDWARE">
                <TabItem.Resources>
                    <DataTemplate x:Key="DiagnosticCardTemplate">
                        <Border Style="{StaticResource Panel}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" FontSize="18" />
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource PanelText}" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Issue}" Foreground="{StaticResource Amber}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Issue}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </TabItem.Resources>
                <Grid x:Name="DiagnosticSurface">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="28,24,28,0">
                        <StackPanel>
                            <TextBlock x:Name="DiagnosticHeading" Text="Sistema" Style="{StaticResource PageTitle}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="AnalyzeButton" Content="Analisar computador" Click="AnalyzeButton_Click"
                                        Style="{StaticResource ActionButton}" Background="{StaticResource Teal}"
                                        BorderBrush="{StaticResource Teal}" Margin="0,0,10,0" />
                                <Button x:Name="ExportButton" Content="Exportar relatório" Click="ExportButton_Click"
                                        Style="{StaticResource SecondaryButton}" Background="{StaticResource TealTint}"
                                        Foreground="{StaticResource Teal}" BorderBrush="{StaticResource Teal}" IsEnabled="False" />
                                <Button x:Name="NetworkTestsLink" Content="Abrir testes de rede" Style="{StaticResource SecondaryButton}"
                                        Visibility="Collapsed" Margin="8,0,0,0" Click="OverviewTests_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="DiagnosticScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="28,14,28,16">
                        <Grid MaxWidth="1150">
                            <Border x:Name="EmptyPanel" Style="{StaticResource Panel}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Inventário do computador" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Clique em Analisar computador para coletar os dados desta categoria e das demais."
                                               Style="{StaticResource PanelText}" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="DiagnosticCards" Visibility="Collapsed" SizeChanged="DiagnosticCards_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="DiagnosticGapColumn" Width="0" />
                                    <ColumnDefinition x:Name="DiagnosticRightColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl x:Name="Results" ItemTemplate="{StaticResource DiagnosticCardTemplate}" />
                                <ItemsControl x:Name="DiagnosticSecondaryResults" Grid.Column="2" ItemTemplate="{StaticResource DiagnosticCardTemplate}" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="SensorsPage" Header="Sensores ao vivo" Tag="&#xE9D9;">
                <monitoring:MonitoringPage Section="Sensors" />
            </TabItem>
            <TabItem x:Name="GraphicsPage" Header="Placa de vídeo" Tag="&#xE7F4;" />
            <TabItem x:Name="StoragePage" Header="Discos" Tag="&#xEDA2;" />
            <TabItem x:Name="PowerPage" Header="Energia" Tag="&#xE7E8;" />
            <TabItem x:Name="NetworkPage" Header="Rede e IPs" Tag="&#xE968;" />
            <TabItem x:Name="DevicesPage" Header="Dispositivos" Tag="&#xE772;" />

            <TabItem Header="Biblioteca de jogos" Tag="&#xE8F1;" app:NavigationGroups.Title="JOGOS">
                <games:GamesPage />
            </TabItem>
            <TabItem Header="FPS estimado" Tag="&#xE9F3;">
                <games:GamesPage ShowEstimates="True" />
            </TabItem>
            <TabItem Header="Análise de gargalos" Tag="&#xE9D9;">
                <monitoring:MonitoringPage Section="Bottleneck" />
            </TabItem>
            <TabItem Header="Overlay" Tag="&#xE745;">
                <monitoring:MonitoringPage Section="Overlay" />
            </TabItem>

            <TabItem Header="Benchmarks" Tag="&#xE9D2;" app:NavigationGroups.Title="DESEMPENHO">
                <benchmarks:BenchmarkPage />
            </TabItem>
            <TabItem x:Name="TestsPage" Header="Testes de diagnóstico" Tag="&#xE9F3;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,12">
                    <StackPanel MaxWidth="1150">
                        <TextBlock Text="Testes de diagnóstico" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Execute uma verificação rápida e consulte os resultados abaixo."
                                   Style="{StaticResource PanelText}" Margin="0,2,0,18" />
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <StackPanel x:Name="TestsOptions">
                                    <RadioButton x:Name="NetworkTestOption" Content="Rede local" IsChecked="True"
                                                 GroupName="Tests" Tag="{x:Static diagnostics:SystemTestKind.Network}" Style="{StaticResource TestOption}" />
                                    <TextBlock Text="Mede a resposta e a perda de pacotes até um gateway configurado."
                                               Style="{StaticResource TestDescription}" />
                                    <RadioButton Content="Conexão de internet" GroupName="Tests"
                                                 Tag="{x:Static diagnostics:SystemTestKind.Internet}" Style="{StaticResource TestOption}" />
                                    <TextBlock Text="Mede latência, variação, resolução DNS e uma amostra de download e upload de até 10 MiB com a Cloudflare."
                                               Style="{StaticResource TestDescription}" />
                                    <RadioButton x:Name="ProcessorTestOption" Content="Processador" GroupName="Tests"
                                                 Tag="{x:Static diagnostics:SystemTestKind.Processor}" Style="{StaticResource TestOption}" />
                                    <TextBlock Text="Mede a velocidade de uma tarefa breve de cálculo SHA-256."
                                               Style="{StaticResource TestDescription}" />
                                    <RadioButton x:Name="DiskTestOption" Content="Leitura e gravação do disco" GroupName="Tests"
                                                 Tag="{x:Static diagnostics:SystemTestKind.Disk}" Style="{StaticResource TestOption}" />
                                    <TextBlock Text="Grava, lê e verifica um arquivo de 4 MiB na pasta temporária do usuário."
                                               Style="{StaticResource TestDescription}" />
                                </StackPanel>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button x:Name="RunTestButton" Content="Executar teste" Style="{StaticResource ActionButton}"
                                            Click="RunTestButton_Click" />
                                    <Button x:Name="CancelTestButton" Content="Cancelar teste" Style="{StaticResource SecondaryButton}"
                                            Click="CancelTestButton_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TestOutcomePanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TestOutcomeHeading" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="TestOutcomeSummary" Style="{StaticResource PanelText}" AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="TestOutcomeItems" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource PanelText}" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Otimização" Tag="&#xE9D9;" app:NavigationGroups.Title="MANUTENÇÃO">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,8">
                    <StackPanel MaxWidth="1150">
                        <Border Style="{StaticResource Panel}" Padding="20,15" BorderBrush="{StaticResource PrimaryOutline}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button x:Name="VerifySystemButton" Content="Realizar verificação" Style="{StaticResource ActionButton}"
                                            Click="VerifySystemButton_Click" />
                                    <TextBlock x:Name="SampleTimeText" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Verificação de desempenho" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Meça o uso de CPU, RAM, disco e GPU e veja os processos com maior consumo."
                                               Style="{StaticResource PanelText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ItemsControl x:Name="OptimizationCards" Margin="-6,0,-6,0" Tag="2"
                                      SizeChanged="OptimizationCards_SizeChanged" AutomationProperties.Name="Uso dos recursos do computador">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MetricCard" Margin="6,0,6,12" Padding="16,13">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                                <Setter Property="Tag" Value="{StaticResource Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resource}" Value="Memory">
                                                        <Setter Property="Tag" Value="{StaticResource Violet}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Resource}" Value="Disk">
                                                        <Setter Property="Tag" Value="{StaticResource Teal}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Resource}" Value="Gpu">
                                                        <Setter Property="Tag" Value="{StaticResource Green}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                        <Setter Property="Tag" Value="{StaticResource Amber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHighestUsage}" Value="True">
                                                        <Setter Property="Tag" Value="{StaticResource Red}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource RedOutline}" />
                                                        <Setter Property="Background" Value="{StaticResource RedTint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                                        VerticalAlignment="Center" Background="{Binding Tag, ElementName=MetricCard}" />
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" FontSize="16" />
                                            </DockPanel>
                                            <DockPanel LastChildFill="True" Margin="0,5,0,3">
                                                <Border DockPanel.Dock="Right" Padding="6,3" CornerRadius="6" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryTint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Resource}" Value="Memory">
                                                                    <Setter Property="Background" Value="{StaticResource VioletTint}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Resource}" Value="Disk">
                                                                    <Setter Property="Background" Value="{StaticResource TealTint}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Resource}" Value="Gpu">
                                                                    <Setter Property="Background" Value="{StaticResource GreenTint}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasMeasurement}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource WindowBackground}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AmberTint}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHighestUsage}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Surface}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="{Binding Tag, ElementName=MetricCard}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Status}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHighestUsage}" Value="True">
                                                                        <Setter Property="Text" Value="Maior uso" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource InterfaceFont}" FontSize="27" FontWeight="Bold"
                                                           Foreground="{Binding Tag, ElementName=MetricCard}" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Foreground="{Binding Tag, ElementName=MetricCard}"
                                                         AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Status}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MetricProgress}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMeasurement}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource PanelText}" FontSize="12" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighestUsage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Margin="0,10,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConsumers}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding ConsumerHeading}" Foreground="{StaticResource Ink}" FontWeight="SemiBold"
                                                           FontSize="12" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding Consumers}" Margin="0,3,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2,0,0" LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Measurement}" Margin="8,0,0,0"
                                                                           Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource VariableTextFont}"
                                                                           Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Guidance}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Guidance}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="Realizar otimização" Click="OpenResourcePlan_Click" HorizontalAlignment="Left"
                                                    Margin="0,10,0,0" Padding="10,8" BorderBrush="{Binding Tag, ElementName=MetricCard}"
                                                    Foreground="{Binding Tag, ElementName=MetricCard}" AutomationProperties.HelpText="{Binding Title}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActions}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="PlanPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="PlanObjective" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="PlanEvidence" Style="{StaticResource PanelText}" FontWeight="SemiBold" />
                                <ItemsControl x:Name="PlanActions" Margin="0,7,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Margin="0,7,0,0" Padding="0,10,0,0">
                                                <CheckBox VerticalContentAlignment="Center"
                                                          Checked="PlanChoice_Changed" Unchecked="PlanChoice_Changed"
                                                          AutomationProperties.Name="{Binding Action.Title}"
                                                          AutomationProperties.HelpText="{Binding Action.Impact}">
                                                    <StackPanel Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Action.Title}" Foreground="{StaticResource Ink}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Action.Evidence}" Style="{StaticResource PanelText}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Action.Impact}" Style="{StaticResource PanelText}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="ApplyPlanButton" Content="Aplicar ações selecionadas" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Click="ApplyPlanButton_Click"
                                        Visibility="Collapsed" IsEnabled="False" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="OptimizationResultPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Resultado da sessão" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="OptimizationResultText" Style="{StaticResource PanelText}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RestorePriorityButton" Content="Restaurar prioridades" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,2,0,10" Click="RestorePriorityButton_Click"
                                Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TemporaryFilesPage" Header="Arquivos temporários" Tag="&#xE74D;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,8">
                    <StackPanel MaxWidth="1150">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Temporários do seu perfil" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Verifique arquivos .tmp e .temp com mais de 7 dias na pasta local de temporários do seu perfil."
                                           Style="{StaticResource PanelText}" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="TempScanButton" Content="Verificar temporários" Style="{StaticResource ActionButton}"
                                            Background="{StaticResource Violet}" BorderBrush="{StaticResource Violet}"
                                            Margin="0,0,8,0" Click="TempScanButton_Click" />
                                    <Button x:Name="TempCleanButton" Content="Limpar arquivos elegíveis" Style="{StaticResource SecondaryButton}"
                                            Background="{StaticResource VioletTint}" Foreground="{StaticResource Violet}"
                                            BorderBrush="{StaticResource Violet}" IsEnabled="False" Click="TempCleanButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="TempResultsPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TempResultsHeading" Style="{StaticResource PanelTitle}" />
                                <TextBlock x:Name="TempResultsText" Style="{StaticResource PanelText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="WindowsRepairPage" Header="Reparo do Windows" Tag="&#xEA86;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,8">
                    <StackPanel MaxWidth="1150">
                        <Border Style="{StaticResource Panel}" Padding="20,15">
                            <StackPanel>
                                <TextBlock Text="Reparo do Windows" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text="Verifique ou repare a instalação atual do Windows. O sistema pode pedir autorização de administrador."
                                           Style="{StaticResource PanelText}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="175" MaxWidth="320" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="8" VerticalAlignment="Top">
                                <ListBox x:Name="RepairOperationList" SelectedIndex="0" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Operações de reparo do Windows">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="OperationFrame" Background="Transparent" BorderBrush="Transparent"
                                                                BorderThickness="1" CornerRadius="6" Padding="10,7">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="OperationFrame" Property="Background" Value="{StaticResource WindowBackground}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="OperationFrame" Property="Background" Value="{StaticResource AmberTint}" />
                                                                <Setter TargetName="OperationFrame" Property="BorderBrush" Value="{StaticResource Outline}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="OperationFrame" Property="BorderBrush" Value="{StaticResource Amber}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Command.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="16,14" VerticalAlignment="Top"
                                    DataContext="{Binding SelectedItem, ElementName=RepairOperationList}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Command.Title}" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="{Binding Command.Description}" Style="{StaticResource PanelText}" />
                                    <TextBlock Text="{Binding Command.CommandLine}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ink}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Command.LogFile, StringFormat='Registro do Windows · {0}'}"
                                               Style="{StaticResource PanelText}" FontSize="12" />

                                    <Button x:Name="StartRepairButton" Content="Executar operação" Style="{StaticResource ActionButton}"
                                            Background="{StaticResource Amber}" BorderBrush="{StaticResource Amber}"
                                            Click="StartRepairButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,12,0,5"
                                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar x:Name="RepairProgressBar" Value="{Binding ProgressValue, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}" Height="8" Foreground="{StaticResource Amber}"
                                                 AutomationProperties.Name="Progresso da operação selecionada" />
                                    <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource PanelText}">
                                        <TextBlock.Visibility>
                                            <Binding Path="ResultVisibility" />
                                        </TextBlock.Visibility>
                                    </TextBlock>

                                    <TextBlock Text="Saída do Windows" FontWeight="SemiBold" Margin="0,12,0,5" />
                                    <TextBox x:Name="RepairOutput" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Height="128"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             Background="{StaticResource WindowBackground}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Outline}" Padding="8"
                                             FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Saída do Windows" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Inicialização" Tag="&#xE823;">
                <tools:ToolsPage Section="Startup" />
            </TabItem>
            <TabItem Header="Instalar aplicativos" Tag="&#xE896;">
                <tools:ToolsPage Section="Apps" />
            </TabItem>
            <TabItem Header="Drivers" Tag="&#xE950;">
                <tools:ToolsPage Section="Drivers" />
            </TabItem>
            <TabItem Header="Iluminação iCUE" Tag="&#xE706;" app:NavigationGroups.Title="INTEGRAÇÕES">
                <tools:ToolsPage Section="Lighting" />
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="ScanProgress" Grid.Row="1" Foreground="{StaticResource Teal}" Visibility="Hidden"
                     IsIndeterminate="True" AutomationProperties.Name="Operação em andamento" />
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Padding="24,8">
            <TextBlock x:Name="StatusText" FontFamily="{StaticResource VariableTextFont}" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap"
                       Text="Pronto." AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
