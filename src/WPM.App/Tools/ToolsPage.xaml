<UserControl x:Class="WPM.App.Tools.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,12">
        <StackPanel MaxWidth="1150">
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
            <Border x:Name="InventoryPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <WrapPanel>
                        <Button x:Name="RefreshButton" Content="Atualizar lista" Style="{StaticResource ActionButton}"
                                Click="Refresh_Click" Margin="0,0,8,6" />
                        <Button x:Name="SystemButton" Style="{StaticResource SecondaryButton}" Click="System_Click" Margin="0,0,8,6" />
                        <Button x:Name="DeviceManagerButton" Content="Gerenciador de Dispositivos" Style="{StaticResource SecondaryButton}"
                                Click="DeviceManager_Click" Margin="0,0,0,6" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock x:Name="InventoryStatus" Style="{StaticResource PanelText}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel x:Name="DriverFilterPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Label Content="_Filtrar por dispositivo, fornecedor ou versão" Target="{Binding ElementName=DriverFilter}" Padding="0,0,0,4" />
                        <TextBox x:Name="DriverFilter" Padding="6" TextChanged="DriverFilter_Changed" />
                    </StackPanel>
                    <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="0,12,0,0" MaxHeight="485" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="NameColumn" Header="Nome" Binding="{Binding Name}" Width="1.5*" />
                            <DataGridTextColumn x:Name="DetailColumn" Binding="{Binding Detail}" Width="2*" />
                            <DataGridTextColumn x:Name="LocationColumn" Binding="{Binding Location}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border x:Name="AppsPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="O WinGet abre o instalador e exibe os termos e solicitações de permissão." Style="{StaticResource PanelText}" Margin="0,0,0,12" />
                    <Label Content="_Aplicativo" Target="{Binding ElementName=AppChoice}" Padding="0,0,0,5" />
                    <ComboBox x:Name="AppChoice" Width="230" HorizontalAlignment="Left" DisplayMemberPath="Name" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="InstallButton" Content="Instalar com WinGet" Style="{StaticResource ActionButton}" Click="Install_Click" Margin="0,0,8,0" />
                        <Button Content="Obter o WinGet" Style="{StaticResource SecondaryButton}" Click="GetWinGet_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="AppsStatus" Style="{StaticResource PanelText}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border x:Name="LightingPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Com o iCUE aberto e a opção iCUE SDK ativada, selecione a DLL x64 do SDK 4.0.84 e conecte." Style="{StaticResource PanelText}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button x:Name="ConnectButton" Content="Selecionar SDK e conectar" Click="Connect_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,6" />
                        <Button Content="Obter SDK oficial" Click="GetSdk_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <StackPanel x:Name="LightingControls" IsEnabled="False" Margin="0,10,0,0">
                        <Label Content="_Dispositivo" Target="{Binding ElementName=LightingDeviceChoice}" Padding="0,0,0,5" />
                        <ComboBox x:Name="LightingDeviceChoice" Width="248" HorizontalAlignment="Left" DisplayMemberPath="Model" />
                        <Label Content="_Cor" Target="{Binding ElementName=ColorChoice}" Padding="0,10,0,5" />
                        <ComboBox x:Name="ColorChoice" Width="150" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Ciano" Tag="#00D4BB" />
                            <ComboBoxItem Content="Azul" Tag="#208BFF" />
                            <ComboBoxItem Content="Violeta" Tag="#AD6CFF" />
                            <ComboBoxItem Content="Branco" Tag="#FFFFFF" />
                            <ComboBoxItem Content="Âmbar" Tag="#FFAA28" />
                            <ComboBoxItem Content="Vermelho" Tag="#FF3048" />
                        </ComboBox>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Aplicar cor" Click="ApplyColor_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0" />
                            <Button Content="Atualizar dispositivos" Click="Devices_Click" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="LightingStatus" Text="Conexão inativa." Style="{StaticResource PanelText}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
