<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DiagnosticoManutencao</AssemblyName>
    <RootNamespace>WPM.App</RootNamespace>
    <Product>Diagnóstico e Manutenção</Product>
    <Version>0.8.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <EmbeddedResource Include="Benchmarks\Shaders\RayTracing.dxil" LogicalName="WPM.App.Benchmarks.Shaders.RayTracing.dxil" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" LinkBase="licenses" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="LEIA-ME.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
