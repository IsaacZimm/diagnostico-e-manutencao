<UserControl x:Class="WPM.App.Games.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,12">
        <StackPanel MaxWidth="1150">
            <TextBlock x:Name="PageHeading" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
            <Border x:Name="LibraryPanel" Style="{StaticResource Panel}">
                <StackPanel>
                    <WrapPanel>
                        <Button x:Name="ScanLibraryButton" Content="Buscar jogos instalados" Click="ScanLibrary_Click"
                                Style="{StaticResource ActionButton}" />
                    </WrapPanel>
                    <TextBlock x:Name="LibraryStatus" Text="Steam, Epic Games, GOG e Ubisoft Connect."
                               Style="{StaticResource PanelText}" Margin="0,12,0,6" AutomationProperties.LiveSetting="Polite" />
                    <DataGrid x:Name="LibraryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Visibility="Collapsed"
                              HeadersVisibility="Column" MinHeight="110" MaxHeight="390" AutomationProperties.Name="Jogos instalados">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jogo" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Loja" Binding="{Binding Store}" Width="*" />
                            <DataGridTextColumn Header="Pasta instalada" Binding="{Binding Folder}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border x:Name="EstimatesPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProcessorText" Text="Detectando processador…" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,6">
                        <StackPanel Margin="0,0,10,8">
                            <Label Content="_Placa de vídeo" Target="{Binding ElementName=GpuSelector}" Padding="0,0,0,4" />
                            <ComboBox x:Name="GpuSelector" Width="236" SelectionChanged="EstimateOption_Changed" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <Label Content="_Resolução" Target="{Binding ElementName=ResolutionSelector}" Padding="0,0,0,4" />
                            <ComboBox x:Name="ResolutionSelector" Width="116" SelectionChanged="EstimateOption_Changed">
                                <ComboBoxItem Content="1080p" Tag="1920x1080" />
                                <ComboBoxItem Content="1440p" Tag="2560x1440" />
                                <ComboBoxItem Content="4K" Tag="3840x2160" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <Label Content="_Qualidade" Target="{Binding ElementName=PresetSelector}" Padding="0,0,0,4" />
                            <ComboBox x:Name="PresetSelector" Width="102" SelectionChanged="EstimateOption_Changed">
                                <ComboBoxItem Content="Baixo" />
                                <ComboBoxItem Content="Médio" />
                                <ComboBoxItem Content="Alto" />
                                <ComboBoxItem Content="Ultra" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="EstimateStatus" Style="{StaticResource PanelText}" Margin="0,0,0,12"
                               Text="Estimativa aproximada calculada pelo catálogo local." AutomationProperties.LiveSetting="Polite" />
                    <DataGrid x:Name="EstimateGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Visibility="Collapsed"
                              HeadersVisibility="Column" MinHeight="100" MaxHeight="440" AutomationProperties.Name="FPS estimado por jogo">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jogo" Binding="{Binding Game}" Width="2*" />
                            <DataGridTextColumn Header="FPS médio estimado" Binding="{Binding Fps}" Width="*" />
                            <DataGridTextColumn Header="Limite previsto pelo modelo" Binding="{Binding Limiter}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
